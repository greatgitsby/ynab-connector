{
  "name": "ynab-connector",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "scripts": {
    "dev": "wrangler dev --local-upstream localhost:8787",
    "start": "wrangler dev --local-upstream localhost:8787",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "check": "bun check --no-script && bun check --no-script -p tsconfig.test.json",
    "lint": "oxlint --deny-warnings",
    "test": "bun test",
    "eval": "bun test ./evals/*.eval.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.3.0",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "^0.34.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/bun": "^1.4.5",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2009",
    "typescript": "7.0.2",
    "wrangler": "^4.167.0"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ]
}

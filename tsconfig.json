{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // Worker code only. Tests and evals run under Bun and get Bun's types in
  // tsconfig.test.json; keeping them out of here means worker code can't
  // type-check against a Bun API that workerd doesn't have.
  "include": ["src/**/*.ts", "worker-configuration.d.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.fixture.ts"]
}

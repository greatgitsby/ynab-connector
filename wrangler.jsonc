{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ynab-connector",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"migrations": [
		{
			"new_sqlite_classes": [
				"YnabMcp"
			],
			"tag": "v1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "YnabMcp",
				"name": "MCP_OBJECT"
			}
		]
	},
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "e8aa9cdf03b34b1b9e79de520afa4b99"
		}
	],
	"observability": {
		"enabled": true
	}
}